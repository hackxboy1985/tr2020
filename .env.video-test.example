# 视频生成系统测试环境配置
# 复制此文件为 .env.video-test 并填入真实值

# ==========================================
# 选择渠道类型（二选一）
# ==========================================

# 方式1：使用三方平台渠道（默认，推荐）
VIDEO_GENERATION_CHANNEL=platform
PLATFORM_BASE_URL=https://your-platform.example.com
PLATFORM_API_KEY=your_platform_api_key_here
PLATFORM_API_SECRET=your_platform_secret_here  # 可选，用于webhook签名验证

# 方式2：使用Coze渠道
# VIDEO_GENERATION_CHANNEL=coze
# COZE_API_KEY=your_coze_api_key_here
# COZE_WORKFLOW_ID=your_workflow_id_here
# COZE_WEBHOOK_SECRET=your_webhook_secret_here
# COZE_BASE_URL=https://api.coze.cn  # 可选，默认值

# ==========================================
# 数据库配置（已有配置保持不变）
# ==========================================
# SQL_DSN=root:123456@tcp(localhost:3306)/new-api?charset=utf8mb4&parseTime=True&loc=Local

# ==========================================
# 其他可选配置
# ==========================================
# PORT=3000
# LOG_LEVEL=info
